{
    "name": "warehouse/5s-inspection",
    "description": "仓库现场5S检查整改系统（ThinkPHP8 + MySQL）",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0.0",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0",
        "topthink/think-view": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
